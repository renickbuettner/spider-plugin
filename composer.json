{
    "name": "renick/spider-plugin",
    "type": "october-plugin",
    "description": "OctoberCMS plugin for crawling your local site, finding not found errors, warm up all caches and resizer images.",
    "require": {
        "php": ">=8.1",
        "composer/installers": "^1.0 || ^2.0",
        "laravel/framework": ">=9.0",
        "spatie/crawler": "^8.2 || ^9.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true
        }
    }
}
